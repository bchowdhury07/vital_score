# ==========================================
# VitalScore - Git Ignore Rules
# ==========================================

# 1. Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Package & Build Artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# PyMC / PyTensor Cache
.theano/
.pytensor/

# 2. Node.js & Frontend (React + Vite)
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# 4. Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# 5. Large Binary Model Dumps (Allow versioned artifacts)
*.joblib
*.pkl
*.pickle
# Explicitly keep the lightweight (~44KB) trained baseline artifacts
!backend/artifacts/model_artifacts_v*.joblib
!backend/artifacts/metadata_v*.json
